# ⚠️ 这是脱敏模板：所有 Token / 代理 / 密钥已清空。
# 用法：cp .env.example .env 然后填入自己的值。
# SmolVLA + LIBERO 环境变量配置模板
# 使用方法：cp .env.example .env，然后修改下面的配置

# ============================================
# Hugging Face 配置
# ============================================

# 模型下载端点（可选，用于加速国内下载）
# 选项 1: 国内镜像站（推荐）
HF_ENDPOINT=https://hf-mirror.com

# 选项 2: 官方地址
# HF_ENDPOINT=https://huggingface.co

# Hugging Face 缓存目录
HF_HOME=~/.cache/huggingface

# Hugging Face API Token（可选，用于私有模型）
HF_TOKEN=

# ============================================
# CUDA 配置
# ============================================

# 使用的 GPU 设备（0=第一块GPU，多块GPU可用逗号分隔：0,1,2,3）
CUDA_VISIBLE_DEVICES=0

# ============================================
# 项目路径配置
# ============================================

# LeRobot 项目根目录
LEROBOT_HOME=/path/to/robotics

# 模型存储目录
LEROBOT_MODELS=/path/to/robotics/models

# ============================================
# LIBERO 配置
# ============================================
# ⚠️ 不要设置 LIBERO_HOME / LIBERO_ASSETS —— LIBERO 不认这两个变量。
#    LIBERO 只读下面这个变量（默认就是 ~/.libero）以及其中的 config.yaml。
LIBERO_CONFIG_PATH=~/.libero

# ============================================
# MuJoCo 渲染后端
# ============================================
# 服务器无显示器时必须用 egl，否则建环境会失败。
MUJOCO_GL=egl

# ============================================
# 说明
# ============================================
# lerobot-eval 不会自动加载 .env，本文件仅供参考。
# 运行前请在 shell 里 export，或直接用 scripts/run.sh scripts/eval.py（它已自动导出）。

# ============================================
# 可选：代理配置（仅在使用代理时需要）
# ============================================

# HTTP 代理
# HTTP_PROXY=

# HTTPS 代理
# HTTPS_PROXY=

# ============================================
# 调试配置（可选）
# ============================================

# 日志级别：DEBUG, INFO, WARNING, ERROR
# LOG_LEVEL=INFO

# PyTorch 调试
# PYTORCH_ENABLE_MPS_FALLBACK=1
